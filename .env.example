# Recall AI 后端环境变量配置
# 复制此文件为 api/.env 并修改对应值
# ⚠️ 生产环境（Render 部署）请使用强随机 JWT_SECRET，切勿使用示例值

# JWT 密钥（必填，生产环境请换成 32 位以上随机字符串）
JWT_SECRET=recall-ai-jwt-secret-2026

# API 端口（本地开发用；Render 部署时会自动注入 PORT，无需手动设置）
PORT=3001

# 跨域白名单（逗号分隔，生产环境填前端公网地址）
# 示例：CORS_ORIGIN=https://recall-ai.vercel.app,http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# ===== 大模型 API 配置（AI 答疑功能） =====
# 支持任何 OpenAI 兼容接口：DeepSeek 官方 / 火山引擎 / 阿里云等
# DeepSeek 官方示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 火山引擎（Ark）示例：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=填你在方舟创建的接入点模型名
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# 不配置 LLM_API_KEY 时，AI 答疑自动降级为 Mock 模式（功能可用但非真实 AI）

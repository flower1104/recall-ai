# Recall AI 环境变量配置
# 复制此文件为 .env 并修改对应值

# JWT密钥
JWT_SECRET=recall-ai-jwt-secret-2026

# API端口
PORT=3001

# DeepSeek API Key（AI对话功能）
# DEEPSEEK_API_KEY=your-api-key-here

# PostgreSQL数据库连接（如启用）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=recall
# DB_USER=recall
# DB_PASSWORD=your-password

# Redis连接
# REDIS_URL=redis://localhost:6379

# 对象存储配置
# OSS_ACCESS_KEY_ID=your-access-key
# OSS_ACCESS_KEY_SECRET=your-secret-key
# OSS_BUCKET=recall-images
